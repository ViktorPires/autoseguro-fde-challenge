APP_ENV=production
LANGUAGE_PROVIDER=gemini
LANGUAGE_MODEL=gemini-3.8-flash
LLM_DEADLINE=30
QUOTE_DEADLINE=39
TURN_DEADLINE=40
FINALIZATION_RESERVE=1
